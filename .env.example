# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Resend API key (resend.com) - used by the reminder cron to email a daily
# summary
RESEND_API_KEY=
